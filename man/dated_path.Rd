   \code{dpp(x)} \tab \code{dated_path(x, ymd = TRUE, hms = FALSE, print = TRUE)} \cr
   \code{dtpp(x)} \tab \code{dated_path(x, ymd = TRUE, hms = TRUE,  print = TRUE)} \cr
